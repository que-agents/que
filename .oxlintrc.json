{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "oxc", "vitest", "import"],
  "jsPlugins": [{ "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }],
  "ignorePatterns": [
    "out",
    "node_modules",
    "test-results",
    "release",
    ".private",
    "tools/oxlint/anti-slop"
  ],
  "rules": {
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/require-readable-spacing": "error",
    // Specs wait with expect.poll inside beforeEach; a hook failing the test is the point.
    "vitest/no-standalone-expect": [
      "error",
      { "additionalTestBlockFunctions": ["beforeEach", "beforeAll"] }
    ],
    // expect(value, message) is how a failure says what was being checked.
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    // Off until #84 decodes the Claude stream, gh and Jira CLI JSON at the boundary: their 143 hits
    // are typeof ladders re-checking that JSON, and the fix is the decoders, not lint cleanup.
    "anti-slop/no-runtime-typeof": "off",
    "anti-slop/no-unsafe-dictionary-type": "off",
    "anti-slop/no-unknown-parameters": "off",
    "anti-slop/no-known-value-widening": "off",
    // Off: 221 hits, mostly at the same boundaries; a comment per cast adds noise, not safety.
    "anti-slop/require-safety-comment-for-type-assertion": "off"
  }
}
