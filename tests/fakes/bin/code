#!/usr/bin/env node
// Fake editor launcher for que's tests: records the call, opens nothing.
'use strict'

const fs = require('node:fs')

const log = process.env.QUE_FAKE_CODE_LOG
if (log) {
  const entry = { argv: process.argv.slice(2), cwd: process.cwd(), ts: new Date().toISOString() }
  fs.appendFileSync(log, `${JSON.stringify(entry)}\n`)
}
process.exitCode = 0
