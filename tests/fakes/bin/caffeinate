#!/usr/bin/env node
// Fake caffeinate for que's tests: records its invocation, then holds on
// until it is killed or the `-w <pid>` process exits, like the real one.
// See tests/fakes/README.md.
'use strict'

const fs = require('node:fs')

const argv = process.argv.slice(2)
const log = process.env.QUE_FAKE_CAFFEINATE_LOG
if (log) {
  fs.appendFileSync(
    log,
    `${JSON.stringify({ argv, cwd: process.cwd(), pid: process.pid, ts: new Date().toISOString() })}\n`
  )
}

const w = argv.indexOf('-w')
const watched = w >= 0 ? Number(argv[w + 1]) : NaN

function alive(pid) {
  try {
    process.kill(pid, 0)
    return true
  } catch (err) {
    return err.code === 'EPERM'
  }
}

process.on('SIGTERM', () => process.exit(0))
process.on('SIGINT', () => process.exit(0))
setInterval(() => {
  if (Number.isFinite(watched) && !alive(watched)) process.exit(0)
}, 250)
