#!/usr/bin/env node
// Fake GitHub CLI for que's tests: records every call and answers the few
// subcommands que uses. See tests/fakes/README.md.
'use strict'

const fs = require('node:fs')
const { spawnSync } = require('node:child_process')

const argv = process.argv.slice(2)
const log = process.env.QUE_FAKE_GH_LOG
const prsFile = process.env.QUE_FAKE_GH_PRS

function priorPrCreates() {
  if (!log || !fs.existsSync(log)) return 0
  return fs
    .readFileSync(log, 'utf8')
    .split('\n')
    .filter(Boolean)
    .map((line) => {
      try {
        return JSON.parse(line).argv
      } catch {
        return []
      }
    })
    .filter((a) => Array.isArray(a) && a[0] === 'pr' && a[1] === 'create').length
}

function readPrs() {
  if (!prsFile || !fs.existsSync(prsFile)) return {}
  try {
    return JSON.parse(fs.readFileSync(prsFile, 'utf8'))
  } catch {
    return {}
  }
}

const VIEW_FIELDS = [
  'number',
  'url',
  'title',
  'state',
  'isDraft',
  'reviewDecision',
  'statusCheckRollup',
  'mergedAt',
  'updatedAt',
  'additions',
  'deletions',
  'baseRefName',
  'headRefName',
  'comments',
  'reviews'
]

/** Every pull request in the file, newest first by number, as `gh pr list` orders them. */
function allPrs(prs) {
  return Object.values(prs)
    .flat()
    .sort((a, b) => (b.number ?? 0) - (a.number ?? 0))
}

function prByNumber(n) {
  return allPrs(readPrs()).find((pr) => pr.number === n)
}

function failIfAsked() {
  if (process.env.QUE_FAKE_GH_FAIL) {
    process.stderr.write('gh: failed (fake)\n')
    process.exit(1)
  }
}

/** git's trimmed stdout in the cwd, or '' when it fails. */
function gitOut(args) {
  const r = spawnSync('git', args, { cwd: process.cwd(), encoding: 'utf8' })
  return r.status === 0 ? r.stdout.trim() : ''
}

/** origin's default branch (origin/HEAD), else main. */
function defaultBranch() {
  const ref = gitOut(['symbolic-ref', '--quiet', '--short', 'refs/remotes/origin/HEAD'])
  return ref.startsWith('origin/') ? ref.slice('origin/'.length) : 'main'
}

function flag(name) {
  const i = argv.indexOf(name)
  return i >= 0 ? argv[i + 1] : undefined
}

const prNumber = priorPrCreates() + 1
if (log) {
  fs.appendFileSync(log, `${JSON.stringify({ argv, cwd: process.cwd(), ts: new Date().toISOString() })}\n`)
}

const [cmd, sub] = argv
if (cmd === 'auth' && sub === 'status') {
  process.stdout.write(
    [
      'github.com',
      '  ✓ Logged in to github.com account que-test (keyring)',
      '  - Active account: true',
      '  - Git operations protocol: https',
      "  - Token: gho_************************************",
      "  - Token scopes: 'gist', 'read:org', 'repo', 'workflow'",
      ''
    ].join('\n')
  )
} else if (cmd === 'pr' && sub === 'create') {
  const url = `https://github.com/rquellh/que/pull/${prNumber}`
  if (prsFile) {
    const head = flag('--head') ?? gitOut(['rev-parse', '--abbrev-ref', 'HEAD'])
    if (head) {
      const prs = readPrs()
      const created = {
        number: prNumber,
        url,
        title: flag('--title') ?? '',
        state: 'OPEN',
        isDraft: argv.includes('--draft'),
        baseRefName: flag('--base') ?? defaultBranch(),
        headRefName: head,
        reviewDecision: '',
        statusCheckRollup: [],
        mergedAt: null,
        updatedAt: new Date().toISOString()
      }
      // Like GitHub, a branch holds one open pull request: a new one replaces it,
      // and otherwise joins the branch's merged and closed ones.
      prs[head] = [...(prs[head] ?? []).filter((pr) => pr.state !== 'OPEN'), created]
      fs.writeFileSync(prsFile, JSON.stringify(prs, null, 2))
    }
  }
  process.stdout.write(`${url}\n`)
} else if (cmd === 'pr' && sub === 'list') {
  if (process.env.QUE_FAKE_GH_FAIL) {
    process.stderr.write('gh: failed (fake)\n')
    process.exit(1)
  }
  const head = flag('--head')
  const prs = readPrs()
  const entries = head === undefined ? allPrs(prs) : allPrs({ [head]: prs[head] ?? [] })
  const limit = Number(flag('--limit') ?? 30)
  const fields = (flag('--json') ?? '').split(',').filter(Boolean)
  const out = entries
    .slice(0, limit)
    .map((entry) => Object.fromEntries(fields.filter((f) => f in entry).map((f) => [f, entry[f]])))
  process.stdout.write(`${JSON.stringify(out)}\n`)
} else if (cmd === 'pr' && sub === 'view') {
  failIfAsked()
  const n = Number(argv[2])
  const entry = prByNumber(n)
  if (!entry) {
    process.stderr.write(`gh: no pull request #${argv[2]} (fake)\n`)
    process.exit(1)
  }
  const full = { comments: [], reviews: [], ...entry }
  const fields = (flag('--json') ?? '').split(',').filter((f) => VIEW_FIELDS.includes(f))
  process.stdout.write(`${JSON.stringify(Object.fromEntries(fields.map((f) => [f, full[f] ?? null])))}\n`)
} else if (cmd === 'api') {
  failIfAsked()
  const path = argv.slice(1).find((a) => !a.startsWith('-') && a !== 'GET') ?? ''
  const m = /^\/?repos\/[^/]+\/[^/]+\/pulls\/(\d+)\/comments$/.exec(path)
  const entry = m ? prByNumber(Number(m[1])) : undefined
  if (!entry) {
    process.stderr.write(`gh: Not Found (HTTP 404) (fake: ${path})\n`)
    process.exit(1)
  }
  process.stdout.write(`${JSON.stringify(entry.lineComments ?? [])}\n`)
} else if (cmd === '--version') {
  process.stdout.write('gh version 2.80.0 (2026-09-01)\n')
}
process.exitCode = 0
