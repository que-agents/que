{
  "name": "que",
  "productName": "que",
  "version": "0.1.0",
  "private": true,
  "description": "A macOS app for running Claude Code sessions in git worktrees, with an overnight queue and a quiet mode.",
  "author": "Ryan Quellhorst",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rquellh/que.git"
  },
  "homepage": "https://github.com/rquellh/que#readme",
  "bugs": {
    "url": "https://github.com/rquellh/que/issues"
  },
  "keywords": [
    "claude-code",
    "git-worktree",
    "electron",
    "macos",
    "terminal",
    "agents",
    "overnight",
    "quiet-hours"
  ],
  "engines": {
    "node": ">=24"
  },
  "main": "./out/main/index.js",
  "bin": {
    "que": "bin/que"
  },
  "scripts": {
    "dev": "npm run build:node && electron-vite dev",
    "build": "electron-vite build && npm run build:node",
    "build:node": "node scripts/build-node.mjs",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint && oxfmt --check --ignore-path .gitignore --ignore-path .oxfmtignore .",
    "format": "oxfmt --write --ignore-path .gitignore --ignore-path .oxfmtignore .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "QUE_CONTRACT=1 vitest run --project node tests/contract",
    "smoke": "npm run build:node && node scripts/smoke.mjs",
    "e2e": "npm run build && playwright test",
    "verify": "node scripts/verify.mjs",
    "test:flaky": "node scripts/flake-hunt.mjs",
    "package": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir",
    "dist": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "soak": "npm run build:node && node scripts/soak.mjs",
    "release": "node scripts/release.mjs",
    "docs": "npm run build:node && node scripts/cli-reference.mjs && node scripts/config-reference.mjs",
    "icon": "node scripts/make-icon.mjs",
    "postinstall": "electron-builder install-app-deps",
    "prepare": "husky"
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "commander": "^15.0.0",
    "node-pty": "^1.1.0",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.88.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "oxlint",
      "oxfmt --write --ignore-path .gitignore --ignore-path .oxfmtignore"
    ],
    "*.{css,md,json,yml,yaml}": [
      "oxfmt --write --ignore-path .gitignore --ignore-path .oxfmtignore"
    ]
  }
}
