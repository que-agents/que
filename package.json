{
  "name": "que",
  "productName": "que",
  "version": "0.0.1",
  "private": true,
  "description": "Workspace app for running Claude Code sessions in git worktrees, with a quiet mode.",
  "author": "Ryan Quellhorst",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "bin": {
    "que": "bin/que"
  },
  "scripts": {
    "dev": "npm run build:node && electron-vite dev",
    "build": "electron-vite build && npm run build:node",
    "build:node": "node scripts/build-node.mjs",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "smoke": "npm run build:node && node scripts/smoke.mjs",
    "e2e": "npm run build && playwright test",
    "postinstall": "electron-rebuild -f -o node-pty"
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "commander": "^15.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^41.10.7",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  }
}
